<?xml version="1.0" encoding="utf-8"?>

<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:mp="http://schemas.microsoft.com/appx/2014/phone/manifest"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:genTemplate="http://schemas.microsoft.com/appx/developer/templatestudio"
  xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap mp genTemplate desktop rescap">

  <Identity
    Name="26937gabboxl.61420B4860E86"
    Publisher="CN=BE63F29F-B5DE-4216-A286-0EE09F9F43D1"
    Version="2.1.0.0" />

  <mp:PhoneIdentity PhoneProductId="6e0db8e0-d677-43e2-8013-262db7f9ec82" PhonePublisherId="00000000-0000-0000-0000-000000000000"/>

  <Properties>
    <DisplayName>FluentWeather</DisplayName>
    <PublisherDisplayName>gabboxl</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Universal" MinVersion="10.0.0.0" MaxVersionTested="10.0.0.0" />
  </Dependencies>

  <Resources>
    <Resource Language="x-generate"/>
  </Resources>

  <Applications>
    <Application Id="App"
      Executable="$targetnametoken$.exe"
      EntryPoint="FluentWeather.App">
      <uap:VisualElements
        DisplayName="ms-resource:AppDisplayName"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png"
        Description="ms-resource:AppDescription"
        BackgroundColor="transparent">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" Square71x71Logo="Assets\SmallTile.png" Square310x310Logo="Assets\LargeTile.png"/>
        <uap:SplashScreen Image="Assets\SplashScreen.png" />
        <uap:LockScreen Notification="badgeAndTileText" BadgeLogo="Assets\Square44x44LogoBadge.png"/>
      </uap:VisualElements>
      <Extensions>
        <!-- Tray icons (off by default, see Services/TrayIconsService.cs). -->
        <!-- The tray icons program. The app starts it with FullTrustProcessLauncher. -->
        <desktop:Extension Category="windows.fullTrustProcess" Executable="FluentWeatherTray\FluentWeatherTray.exe" />
        <!-- Starts the tray icons program at sign-in. The app turns it on only with the setting on. -->
        <desktop:Extension Category="windows.startupTask" Executable="FluentWeatherTray\FluentWeatherTray.exe" EntryPoint="Windows.FullTrustApplication">
          <desktop:StartupTask TaskId="FluentWeatherTray" Enabled="false" DisplayName="FluentWeather tray icons" />
        </desktop:Extension>
        <!-- The tray icons program asks the app for new data every 5 minutes while the window is closed. -->
        <uap:Extension Category="windows.appService">
          <uap:AppService Name="FluentWeatherTrayRefresh" />
        </uap:Extension>
        <!-- fluentweather:switch?placeId=... opens the app at a saved location. -->
        <uap:Extension Category="windows.protocol">
          <uap:Protocol Name="fluentweather">
            <uap:DisplayName>FluentWeather</uap:DisplayName>
          </uap:Protocol>
        </uap:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <Capability Name="internetClient" />
    <!-- Needed for the tray icons program (windows.fullTrustProcess). -->
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>

  <genTemplate:Metadata>
    <genTemplate:Item Name="generator" Value="Template Studio"/>
    <genTemplate:Item Name="wizardVersion" Version="v5.10" />
    <genTemplate:Item Name="projectType" Value="SplitView" />
    <genTemplate:Item Name="framework" Value="MVVMToolkit" />
    <genTemplate:Item Name="platform" Value="Uwp" />
  </genTemplate:Metadata>
</Package>